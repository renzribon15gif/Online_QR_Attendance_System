<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">ATTENDANCE CONTROL</span><h1>QR sessions</h1><p class="muted">Create secure, time-limited QR codes for your classes.</p></div></section><section class="panel"><div class="section-heading"><div><h2>Create a new session</h2><p class="muted">Students must sign in before scanning the code.</p></div></div><form method="POST" action="/teacher/sessions" class="form inline-form"><div><label>Class / session title</label><input name="title" required placeholder="e.g. Web Programming - Monday"></div><div><label>QR expiry (minutes)</label><input type="number" name="minutes" value="15" min="1" max="240" required></div><button class="btn" type="submit">Generate QR code →</button></form></section><section class="panel"><div class="section-heading"><h2>Session history</h2></div><div class="table-wrap"><table><thead><tr><th>Session</th><th>Created</th><th>Expires</th><th>Status</th><th>Action</th></tr></thead><tbody><% sessions.forEach(s=>{ %><tr><td><b><%= s.title %></b></td><td><%= s.createdAt.toLocaleString() %></td><td><%= s.expiresAt.toLocaleString() %></td><td><span class="status <%= s.active&&s.expiresAt>new Date()?'':'inactive' %>"><%= s.active&&s.expiresAt>new Date()?"Active":"Closed / expired" %></span></td><td><% if(s.active){ %><form method="POST" action="/teacher/sessions/<%= s._id %>/close"><button class="btn small danger" type="submit">Close session</button></form><% }else{ %>—<% } %></td></tr><% }) %><% if(!sessions.length){ %><tr><td colspan="5" class="empty-state">No sessions created yet.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>
