<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">FACULTY MONITORING</span><h1>Teacher accounts</h1><p class="muted">Administrator view of all teacher accounts.</p></div><span class="count-chip"><%= people.length %> teachers</span></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Teacher</th><th>Teacher ID</th><th>Email</th><th>Account created</th><th>Role</th></tr></thead><tbody><% people.forEach(person=>{ %><tr><td><b><%= person.name %></b></td><td><%= person.studentId || "—" %></td><td><%= person.email %></td><td><%= person.createdAt.toLocaleDateString() %></td><td><span class="status teacher-role">Teacher</span></td></tr><% }) %><% if(!people.length){ %><tr><td colspan="5" class="empty-state">No teacher accounts found.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>