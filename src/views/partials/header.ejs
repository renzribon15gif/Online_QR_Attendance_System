<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#102b5c"><meta name="description" content="Attendly — smart QR-based attendance monitoring for teachers and students."><link rel="icon" type="image/svg+xml" href="/images/attendly-logo.svg"><title><%= title %> | Attendly</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="topbar"><a class="brand" href="/"><img class="brand-logo" src="/images/attendly-logo.svg" alt="Attendly logo"><span class="brand-copy">Attendly<small>SMART ATTENDANCE</small></span></a><% if(currentUser){ %><nav><% if(currentUser.role==="admin"){ %><a href="/admin">Overview</a><a href="/admin/teachers">Teachers</a><a href="/admin/students">Students</a><a href="/admin/reports">Reports</a><% }else if(currentUser.role==="teacher"){ %><a href="/teacher">Overview</a><a href="/teacher/students">Students</a><a href="/teacher/sessions">QR Sessions</a><a href="/teacher/reports">Reports</a><% }else{ %><a href="/student">My Dashboard</a><a href="/student/scan">Scan QR</a><% } %><form action="/logout" method="POST" class="logout"><button class="nav-logout" type="submit">Sign out</button></form></nav><% } %></header>
