<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">PEOPLE</span><h1>Student directory</h1><p class="muted">Browse registered student accounts.</p></div><span class="count-chip"><%= students.length %> students</span></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Student</th><th>Student ID</th><th>Email</th><th>Registered</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><b><%= s.name %></b></td><td><%= s.studentId %></td><td><%= s.email %></td><td><%= s.createdAt.toLocaleDateString() %></td></tr><% }) %><% if(!students.length){ %><tr><td colspan="4" class="empty-state">No students registered yet.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>
