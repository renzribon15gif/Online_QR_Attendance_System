<%- include("partials/header",{title}) %><section class="auth-card reveal"><a class="back-link" href="/student/login">← Student login</a><div class="login-icon">＋</div><span class="eyebrow">JOIN ATTENDLY</span><h1>Create student account</h1><p class="muted">Register to access your attendance dashboard.</p><form method="POST" action="/register" class="form"><label>Full name</label><input name="name" required placeholder="Your full name"><label>Student ID</label><input name="studentId" required placeholder="e.g. 2026-0001"><label>Email address</label><input type="email" name="email" required placeholder="you@example.com"><label>Password <small>(at least 8 characters)</small></label><input type="password" name="password" minlength="8" required><label>Confirm password</label><input type="password" name="confirmPassword" minlength="8" required><button class="btn full" type="submit">Create student account →</button></form></section><%- include("partials/footer") %>
