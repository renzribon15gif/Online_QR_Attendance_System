<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">TEACHER WORKSPACE</span><h1>Good day, Teacher <span class="wave">✦</span></h1><p class="muted">Here’s what’s happening with your attendance today.</p></div><a class="btn" href="/teacher/sessions">＋ Create QR session</a></section><div class="stats"><article class="stat reveal"><div class="stat-top"><span class="stat-icon blue">♙</span><span class="stat-trend">All time</span></div><span class="stat-label">Registered students</span><strong><%= studentCount %></strong><small>Student accounts</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon purple">▦</span><span class="stat-trend">All time</span></div><span class="stat-label">QR sessions</span><strong><%= sessionCount %></strong><small>Created attendance sessions</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon green">✓</span><span class="stat-trend">Today</span></div><span class="stat-label">Attendance scans</span><strong><%= todayCount %></strong><small><%= attendanceCount %> total records</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon orange">◷</span><span class="stat-trend live-pill">Live</span></div><span class="stat-label">Active sessions</span><strong><%= activeCount %></strong><small>Currently accepting scans</small></article></div><section class="quick-grid"><a class="quick-action" href="/teacher/sessions"><span class="quick-icon">▦</span><b>Generate QR code</b><small>Start a new attendance session</small><span class="quick-arrow">↗</span></a><a class="quick-action" href="/teacher/students"><span class="quick-icon purple">♙</span><b>Manage students</b><small>View your student directory</small><span class="quick-arrow">↗</span></a><a class="quick-action" href="/teacher/reports"><span class="quick-icon green">▤</span><b>View reports</b><small>Review and export attendance</small><span class="quick-arrow">↗</span></a></section><section class="panel"><div class="section-heading"><div><span class="eyebrow">LATEST ACTIVITY</span><h2>Recent attendance</h2></div><a class="text-link" href="/teacher/reports">View all reports →</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Student ID</th><th>Class / session</th><th>Date and time</th><th>Status</th></tr></thead><tbody><% recent.forEach(record=>{ %><tr><td><b><%= record.student?record.student.name:"Deleted student" %></b></td><td><%= record.student?record.student.studentId:"-" %></td><td><%= record.attendanceSession?record.attendanceSession.title:"Deleted session" %></td><td><%= record.scannedAt.toLocaleString() %></td><td><span class="status"><%= record.status %></span></td></tr><% }) %><% if(!recent.length){ %><tr><td colspan="5" class="empty-state">No attendance activity yet. Create a QR session to get started.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>
