<%- include("partials/header",{title}) %><section class="panel scanner-panel reveal"><span class="eyebrow">STUDENT CHECK-IN</span><h1>Scan attendance QR</h1><p class="muted">Allow camera access and point your camera at your teacher’s QR code.</p><div id="reader"></div><p id="scan-status" class="scan-status">Waiting for camera permission…</p><a class="btn secondary" href="/student">Back to dashboard</a></section><script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script><script>
const statusText=document.getElementById("scan-status");const scanner=new Html5Qrcode("reader");function onScanSuccess(decodedText){try{const url=new URL(decodedText);if(url.origin!==window.location.origin||url.pathname!=="/scan"||!url.searchParams.get("token")){statusText.textContent="This is not a valid attendance QR code.";return;}statusText.textContent="QR detected. Recording attendance…";scanner.stop().finally(()=>window.location.href=url.href);}catch(e){statusText.textContent="Invalid QR code. Please try again.";}}Html5Qrcode.getCameras().then(cameras=>{if(!cameras||!cameras.length)throw new Error("No camera found.");const camera=cameras.find(c=>/back|environment/i.test(c.label))||cameras[0];scanner.start(camera.id,{fps:10,qrbox:{width:230,height:230}},onScanSuccess).then(()=>statusText.textContent="Camera active · Scan the class QR code.").catch(err=>statusText.textContent="Could not start camera: "+err);}).catch(err=>statusText.textContent="Camera unavailable. Allow camera permission and use HTTPS or localhost. "+err);
</script><%- include("partials/footer") %>
