<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">INSIGHTS & RECORDS</span><h1>Attendance reports</h1><p class="muted">Review attendance records and export a CSV copy.</p></div><div class="heading-actions"><a class="btn secondary" href="<%= typeof reportBase !== 'undefined' ? reportBase : '/teacher' %>/reports.csv">↓ Export CSV</a><button class="btn" onclick="window.print()">Print report</button></div></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Student</th><th>Student ID</th><th>Email</th><th>Session</th><th>Date and time</th><th>Status</th></tr></thead><tbody><% records.forEach(r=>{ %><tr><td><b><%= r.student?r.student.name:"Deleted student" %></b></td><td><%= r.student?r.student.studentId:"-" %></td><td><%= r.student?r.student.email:"-" %></td><td><%= r.attendanceSession?r.attendanceSession.title:"Deleted session" %></td><td><%= r.scannedAt.toLocaleString() %></td><td><span class="status"><%= r.status %></span></td></tr><% }) %><% if(!records.length){ %><tr><td colspan="6" class="empty-state">No attendance records available.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>
