<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">STUDENT WORKSPACE</span><h1>Welcome, <%= currentUser.name.split(' ')[0] %> <span class="wave">✦</span></h1><p class="muted">Keep track of your classes and attendance activity.</p></div><a class="btn" href="/student/scan">▦ Scan attendance QR</a></section><div class="stats student-stats"><article class="stat"><div class="stat-top"><span class="stat-icon blue">✓</span></div><span class="stat-label">Total attendance</span><strong><%= records.length %></strong><small>Successful check-ins</small></article><article class="stat"><div class="stat-top"><span class="stat-icon green">▦</span></div><span class="stat-label">Active QR sessions</span><strong><%= activeSessions.length %></strong><small>Available to scan now</small></article><article class="stat"><div class="stat-top"><span class="stat-icon purple">♙</span></div><span class="stat-label">Student ID</span><strong class="id-stat"><%= currentUser.studentId %></strong><small>Your registered ID</small></article></div><section class="panel"><div class="section-heading"><div><span class="eyebrow">READY TO CHECK IN?</span><h2>Active class sessions</h2></div><a class="text-link" href="/student/scan">Open scanner →</a></div><% if(activeSessions.length){ %><div class="active-session-grid"><% activeSessions.forEach(s=>{ %><div class="active-session"><span class="session-live">● ACTIVE</span><h3><%= s.title %></h3><p>Expires <%= s.expiresAt.toLocaleString() %></p><a class="btn small" href="/student/scan">Scan class QR</a></div><% }) %></div><% }else{ %><div class="empty-state">There are no active attendance sessions right now.</div><% } %></section><section class="panel"><div class="section-heading"><div><span class="eyebrow">YOUR RECORD</span><h2>Attendance history</h2></div></div><div class="table-wrap"><table><thead><tr><th>Class / session</th><th>Date and time</th><th>Status</th></tr></thead><tbody><% records.forEach(r=>{ %><tr><td><b><%= r.attendanceSession?r.attendanceSession.title:"Deleted session" %></b></td><td><%= r.scannedAt.toLocaleString() %></td><td><span class="status"><%= r.status %></span></td></tr><% }) %><% if(!records.length){ %><tr><td colspan="3" class="empty-state">Your attendance records will appear here after you scan a class QR code.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>
