<%- include("partials/header",{title}) %><section class="welcome-row"><div><span class="eyebrow">ADMINISTRATOR WORKSPACE</span><h1>Good day, Administrator <span class="wave">✦</span></h1><p class="muted">System-wide overview of teachers, students, and attendance.</p></div><a class="btn" href="/admin/reports">View system reports →</a></section><div class="stats admin-stats"><article class="stat reveal"><div class="stat-top"><span class="stat-icon blue">♙</span><span class="stat-trend">Accounts</span></div><span class="stat-label">Registered students</span><strong><%= studentCount %></strong><small>Across the system</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon purple">♧</span><span class="stat-trend">Faculty</span></div><span class="stat-label">Teacher accounts</span><strong><%= teacherCount %></strong><small>Authorized teachers</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon green">✓</span><span class="stat-trend">Today</span></div><span class="stat-label">Attendance scans today</span><strong><%= todayCount %></strong><small><%= attendanceCount %> total records</small></article><article class="stat reveal"><div class="stat-top"><span class="stat-icon orange">◷</span><span class="stat-trend live-pill">Live</span></div><span class="stat-label">Active QR sessions</span><strong><%= activeCount %></strong><small><%= sessionCount %> sessions created</small></article></div><section class="quick-grid admin-quick-grid"><a class="quick-action" href="/admin/teachers"><span class="quick-icon purple">♧</span><b>Monitor teachers</b><small>View all teacher accounts</small><span class="quick-arrow">↗</span></a><a class="quick-action" href="/admin/students"><span class="quick-icon">♙</span><b>Monitor students</b><small>Browse all registered students</small><span class="quick-arrow">↗</span></a><a class="quick-action" href="/admin/reports"><span class="quick-icon green">▤</span><b>System reports</b><small>Review and export attendance</small><span class="quick-arrow">↗</span></a></section><section class="panel"><div class="section-heading"><div><span class="eyebrow">SYSTEM ACTIVITY</span><h2>Latest attendance records</h2></div><a class="text-link" href="/admin/reports">View all reports →</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Student ID</th><th>Class / session</th><th>Date and time</th><th>Status</th></tr></thead><tbody><% recent.forEach(record=>{ %><tr><td><b><%= record.student?record.student.name:"Deleted student" %></b></td><td><%= record.student?record.student.studentId:"-" %></td><td><%= record.attendanceSession?record.attendanceSession.title:"Deleted session" %></td><td><%= record.scannedAt.toLocaleString() %></td><td><span class="status"><%= record.status %></span></td></tr><% }) %><% if(!recent.length){ %><tr><td colspan="5" class="empty-state">No attendance activity recorded yet.</td></tr><% } %></tbody></table></div></section><%- include("partials/footer") %>